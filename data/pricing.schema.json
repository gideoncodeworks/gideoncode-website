{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://gideoncode.com/data/pricing.schema.json",
  "title": "Gideon Codeworks Pricing Manifest",
  "description": "Public-safe pricing manifest exported from gideon-dashboard. Consumed by the gideoncode.com pricing UI at runtime. Updates land via automated PR from the dashboard; no direct edits.",
  "type": "object",
  "required": [
    "manifestVersion",
    "generatedAt",
    "sourceCommit",
    "sourceRepo",
    "waasTiers",
    "oneTimeBuilds",
    "addOns",
    "hostingPolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 7
    },
    "sourceRepo": {
      "type": "string",
      "minLength": 1
    },
    "waasTiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "setupFee", "monthly12", "monthly24", "pages"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "setupFee": { "type": "number", "minimum": 0 },
          "monthly12": { "type": "number", "minimum": 0 },
          "monthly24": { "type": "number", "minimum": 0 },
          "pages": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "minLength": 1 }
            ]
          }
        }
      }
    },
    "oneTimeBuilds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "price", "supportDays", "pages"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "supportDays": { "type": "integer", "exclusiveMinimum": 0 },
          "pages": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "minLength": 1 }
            ]
          }
        }
      }
    },
    "addOns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "monthly", "setup"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "monthly": { "type": "number", "minimum": 0 },
          "setup": { "type": "number", "minimum": 0 }
        }
      }
    },
    "hostingPolicy": {
      "type": "object",
      "required": ["oneTime", "note"],
      "additionalProperties": false,
      "properties": {
        "oneTime": {
          "type": "string",
          "enum": ["pending", "included-1yr", "billed-separately", "customer-managed", "included-then-optional"]
        },
        "includedMonths": { "type": "integer", "exclusiveMinimum": 0 },
        "continuationMonthly": { "type": "number", "minimum": 0 },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "oneTime": { "const": "included-then-optional" } } },
          "then": { "required": ["includedMonths", "continuationMonthly"] }
        }
      ]
    }
  }
}
