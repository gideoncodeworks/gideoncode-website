{
  "name": "gideoncode-website",
  "version": "1.0.0",
  "description": "Gideon Codeworks website with automated screenshot tools",
  "private": true,
  "scripts": {
    "screenshot": "node screenshot.js",
    "serve": "python3 -m http.server 8000",
    "validate:pricing": "node scripts/validate-pricing.mjs",
    "test:pricing-consistency": "node scripts/pricing-consistency-test.mjs",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.min.css --watch",
    "render:pricing-static": "node scripts/render-pricing-static.mjs"
  },
  "keywords": [
    "website",
    "portfolio",
    "screenshots"
  ],
  "author": "Gideon Codeworks",
  "license": "UNLICENSED",
  "devDependencies": {
    "@vercel/node": "^5.6.11",
    "puppeteer-core": "^22.15.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "stripe": "^14.0.0"
  }
}
